# Copie para `.env` (mesma pasta do docker-compose.yaml) e preencha com seus
# valores. O `.env` é ignorado pelo git (`.gitignore` raiz, padrão `.env`),
# então NUNCA commite o arquivo `.env` real.
#
# Para gerar segredos:
#   openssl rand -hex 32   # AIRFLOW_API_SECRET_KEY / AIRFLOW_API_AUTH_JWT_SECRET
#   openssl rand -hex 16   # POSTGRES_PASSWORD
#   openssl rand -hex 12   # AIRFLOW_WWW_PASSWORD

# --- SSH para a VPS ---------------------------------------------------------
# Caminho absoluto da chave privada usada para SSH (alias "vps" no ~/.ssh/config)
SSH_KEY_PATH=/caminho/absoluto/para/a/chave/privada

# IP/host da VPS e usuário (só usados como fallback se não houver ~/.ssh/config
# montado; normalmente o config montado já traz HostName e User)
VPS_HOST=1.2.3.4
VPS_USER=ubuntu

# --- Segredos do Airflow ----------------------------------------------------
# Segredo do webserver/API (assina cookies de sessão). No Airflow 3 o config
# ficou em [api] (env AIRFLOW__API__SECRET_KEY)
AIRFLOW_API_SECRET_KEY=coloque-um-segredo-longo-aqui

# JWT secret compartilhado ([api_auth] jwt_secret, env AIRFLOW__API_AUTH__JWT_SECRET).
# MESMO valor em api-server, scheduler, worker e dag-processor: o scheduler
# assina o token da task e o api-server valida. Se cada processo gerar o seu
# (comportamento default quando vazio), toda task falha no worker com
# "Invalid auth token".
AIRFLOW_API_AUTH_JWT_SECRET=coloque-um-segredo-longo-aqui

# Credenciais do banco Postgres do Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=coloque-uma-senha-forte-aqui
POSTGRES_DB=airflow

# Usuário admin do webserver (criado pelo serviço airflow-init)
AIRFLOW_WWW_USERNAME=airflow
AIRFLOW_WWW_PASSWORD=coloque-uma-senha-forte-aqui
AIRFLOW_WWW_EMAIL=admin@example.com
